<Project Sdk="Microsoft.NET.Sdk">

  <!-- API HTTP local + interfaz HTML (wwwroot) + plantillas de impresión.
       Es una biblioteca: la hospedan Facturacion.Escritorio (ventana) y Facturacion.Servidor (navegador). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- La interfaz viaja dentro del .dll: no hay archivos sueltos que se puedan perder. -->
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Facturacion.Core\Facturacion.Core.csproj" />
    <ProjectReference Include="..\Facturacion.Datos\Facturacion.Datos.csproj" />
  </ItemGroup>

</Project>
